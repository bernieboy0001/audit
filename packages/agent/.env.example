# Base Sepolia RPC (public, free)
RPC_URL=https://sepolia.base.org

# Wallet that signs the agent's trades (funded testnet wallet)
AGENT_PRIVATE_KEY=

# Wallet that creates demo price movement. Separate from the agent so the
# agent's decisions and the market maker are visibly independent.
MARKET_MAKER_PRIVATE_KEY=

# Optional LLM (OpenAI-compatible). Leave unset to run fully deterministic.
# DeepSeek, OpenRouter, Anthropic-compatible endpoints all work.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Timing (ms per loop cycle, cycles of human veto window, outcome horizon)
CYCLE_MS=15000
VETO_WINDOW_CYCLES=3
OUTCOME_HORIZON_CYCLES=6

# Set to "off" to disable the demo market maker (use a real market instead)
MARKET_MAKER=on

# Dashboard API port
PORT=8787
